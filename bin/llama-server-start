#!/usr/bin/env bash
set -euo pipefail

MODEL="${LLAMA_SERVER_MODEL:-$HOME/.ollama/models/source/DeepSeek-V4-Flash-FP4-FP8-native/DeepSeek-V4-Flash-FP4-FP8-native.gguf}"
PORT="${LLAMA_SERVER_PORT:-53084}"
HOST="${LLAMA_SERVER_HOST:-0.0.0.0}"
THREADS="${LLAMA_SERVER_THREADS:-24}"
CTX="${LLAMA_SERVER_CTX:-65536}"
NGL="${LLAMA_SERVER_NGL:-50}"
BATCH="${LLAMA_SERVER_BATCH:-2048}"
UBATCH="${LLAMA_SERVER_UBATCH:-512}"
NPARALLEL="${LLAMA_SERVER_NPARALLEL:-1}"
FLASH_ATTN="${LLAMA_SERVER_FLASH_ATTN:-off}"
NO_WARMUP="${LLAMA_SERVER_NO_WARMUP:-1}"
LOG_DIR="${LLAMA_SERVER_LOG_DIR:-$HOME/.ollama/logs}"
LOG="$LOG_DIR/llama-server.log"
PIDFILE="$LOG_DIR/llama-server.pid"
MAX_ROT="${LLAMA_SERVER_LOG_ROTATIONS:-5}"

usage() {
  cat <<USAGE
Usage: $(basename "$0") [-m model] [-p port] [-t threads] [-c ctx] [-n ngl] [-b batch] [-ub ubatch] [-fa on|off|auto] [--warmup] [-h]

Options:
  -m  MODEL    Model GGUF path (default: native DeepSeek-V4-Flash FP8/MXFP4)
  -p  PORT     Server port (default: 53084)
  -t  THREADS  CPU threads (default: 24)
  -c  CTX      Context size (default: 65536)
  -n  NGL      GPU layers to offload (default: 50)
  -b  BATCH    Logical batch size (default: 2048)
  -ub UBATCH   Physical micro-batch size (default: 512)
  -fa ATTN     Flash attention: on, off, auto (default: off)
  -s  NPARALLEL Parallel request slots (default: 1)
  --warmup     Enable model warmup on startup (default: disabled)
  -h           Show this help

Environment variables: LLAMA_SERVER_MODEL, LLAMA_SERVER_PORT, LLAMA_SERVER_HOST,
  LLAMA_SERVER_THREADS, LLAMA_SERVER_CTX, LLAMA_SERVER_NGL, LLAMA_SERVER_BATCH,
  LLAMA_SERVER_UBATCH, LLAMA_SERVER_NPARALLEL, LLAMA_SERVER_FLASH_ATTN, LLAMA_SERVER_NO_WARMUP,
  LLAMA_SERVER_LOG_DIR, LLAMA_SERVER_LOG_ROTATIONS
USAGE
}

term() {
  python3 - "$1" <<'PY2'
import os,sys
os.kill(int(sys.argv[1]),9)
PY2
}

alive() {
  python3 - "$1" <<'PY2'
import os,sys
try: os.kill(int(sys.argv[1]),0)
except OSError: raise SystemExit(1)
PY2
}

while getopts ":m:p:t:c:n:b:u:f:s:wh" opt; do
  case "$opt" in
    m) MODEL="$OPTARG" ;;
    p) PORT="$OPTARG" ;;
    t) THREADS="$OPTARG" ;;
    c) CTX="$OPTARG" ;;
    n) NGL="$OPTARG" ;;
    b) BATCH="$OPTARG" ;;
    u) UBATCH="$OPTARG" ;;
    f) FLASH_ATTN="$OPTARG" ;;
    s) NPARALLEL="$OPTARG" ;;
    w) NO_WARMUP=0 ;;
    h) usage; exit 0 ;;
    :) echo "Missing: -$OPTARG" >&2; exit 2 ;;
    \?) echo "Unknown: -$OPTARG" >&2; usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

mkdir -p "$LOG_DIR"
if [[ -f "$PIDFILE" ]]; then
  old=$(cat "$PIDFILE" 2>/dev/null || true)
  [[ -n "$old" ]] && alive "$old" && term "$old"
fi
for p in $(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true); do term "$p"; done

if [[ -f "$LOG" && -s "$LOG" ]]; then
  for ((i=MAX_ROT;i>=1;i--)); do
    [[ -e "${LOG_DIR}/llama-server-${i}.log" ]] && { (( i == MAX_ROT )) && rm -f "${LOG_DIR}/llama-server-${i}.log" || mv -f "${LOG_DIR}/llama-server-${i}.log" "${LOG_DIR}/llama-server-$((i+1)).log"; }
  done
  mv -f "$LOG" "${LOG_DIR}/llama-server-1.log"
fi

# Build extra args
EXTRA_ARGS=()
[[ "$NO_WARMUP" == "1" ]] && EXTRA_ARGS+=(--no-warmup)
[[ "$FLASH_ATTN" != "off" ]] && EXTRA_ARGS+=(--flash-attn "$FLASH_ATTN")

cd "$HOME/.ollama/llama.cpp"
nohup llama-server \
  -m "$MODEL" \
  --port "$PORT" \
  -t "$THREADS" \
  -c "$CTX" \
  -ngl "$NGL" \
  -b "$BATCH" \
  -ub "$UBATCH" \
  -np "$NPARALLEL" \
  --host "$HOST" \
  ${EXTRA_ARGS:+"${EXTRA_ARGS[@]}"} \
  > "$LOG" 2>&1 < /dev/null &

echo $! > "$PIDFILE"
echo "started pid=$! port=$PORT threads=$THREADS ctx=$CTX ngl=$NGL batch=$BATCH ubatch=$UBATCH flash_attn=$FLASH_ATTN n_parallel=$NPARALLEL no_warmup=$NO_WARMUP model=$MODEL log=$LOG"
